#!/usr/bin/env sh
set -eu

staged_files="$(git diff --cached --name-only)"

echo "$staged_files" | grep -E '(^|/)\.env($|\.)' && {
  echo "Commit blocked: .env files are forbidden." >&2
  exit 1
}

git diff --cached -- . ':!package-lock.json' ':!*.png' ':!*.jpg' ':!*.jpeg' |
  grep -E '(TODO|FIXME|HACK|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|sk_live_[A-Za-z0-9]{16,}|TELEGRAM_BOT_TOKEN[=:][^[:space:]]+|DISCORD_BOT_TOKEN[=:][^[:space:]]+|YOU_API_KEY[=:][^[:space:]]+|SERPAPI_KEY[=:][^[:space:]]+|NEXCONN_APP_SECRET[=:][^[:space:]]+)' && {
  echo "Commit blocked: TODO stub or secret-like content detected." >&2
  exit 1
}
